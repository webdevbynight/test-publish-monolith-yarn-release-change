{
  "name": "@webdevbynight/test-publish-monolith-yarn-release-change",
  "version": "0.0.2",
  "description": "Test published monolithic repo for release-change use with Yarn",
  "keywords": [],
  "homepage": "https://github.com/webdevbynight/test-publish-monolith-yarn-release-change",
  "bugs": {
    "url": "https://github.com/webdevbynight/test-publish-monolith-yarn-release-change/issues"
  },
  "author": "Victor Brito (https://victor-brito.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevbynight/test-publish-monolith-yarn-release-change.git"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "import": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "npm": ">=10.9.0",
    "pnpm": ">=11.1.3",
    "yarn": ">=4.9.0"
  },
  "scripts": {
    "biome": "biome check --write .",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:format:check": "biome format .",
    "biome:lint": "biome lint --write .",
    "biome:lint:check": "biome lint .",
    "build": "tsc",
    "dev": "yarn tsc:watch & yarn test:watch",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc:watch": "tsc --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@4.18.1"
}
